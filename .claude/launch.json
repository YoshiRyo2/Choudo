{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "choudo-app",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "app",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "choudo-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "app",
        "run",
        "preview",
        "--",
        "--port",
        "4173"
      ],
      "port": 4173
    },
    {
      "name": "choudo-fetch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "worker",
        "--",
        "--port",
        "8787"
      ],
      "port": 8787
    },
    {
      "name": "choudo-app-local-fetch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "app",
        "run",
        "dev",
        "--",
        "--port",
        "4173",
        "--strictPort"
      ],
      "env": {
        "VITE_FETCH_BASE": "http://localhost:8787"
      },
      "port": 4173
    }
  ]
}
