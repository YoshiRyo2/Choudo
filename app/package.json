{
  "name": "choudo-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "check": "tsc -b && vitest run && npm run data:check --silent",
    "data:check": "node scripts/data-check.mjs",
    "dist:check": "node scripts/dist-check.mjs",
    "fit:report": "node scripts/fit-report.mjs",
    "photos": "node scripts/garment-photos.mjs",
    "icons": "node scripts/app-icons.mjs"
  },
  "dependencies": {
    "@choudo/core": "*",
    "@fontsource/m-plus-rounded-1c": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^26.1.0",
    "onnxruntime-node": "^1.31.1",
    "opentype.js": "^1.3.4",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
